# Copy to .env only if your shell loads it — Clipcrow reads the environment, not this file.
# Everything here is optional; the defaults are right for running on your own machine.

# Where the desk listens. Binding anywhere but 127.0.0.1 REQUIRES CLIPCROW_PASSWORD,
# or the server refuses to start: anyone who reaches it could publish to your channel.
PORT=4317
HOST=127.0.0.1
# CLIPCROW_PASSWORD=choose-a-long-one

# Captures, exports and the OAuth token. Point at a volume when hosting.
# DATA_DIR=/data

# Only needed if the toolchain is not in ./.venv (see setup.sh).
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# PYTHON_PATH=/usr/local/bin/python3

# Your own Google OAuth client, for API uploads. The Chrome extension needs none.
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=

# Absolute paths to local videos for the two reference replay buttons, if you want them.
# CLIPCROW_DEMO_REACTION=
# CLIPCROW_DEMO_CINEMATIC=
